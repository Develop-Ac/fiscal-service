{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compilerOptions": {
        "deleteOutDir": true,
        "assets": [
            { "include": "nfse/danfse/assets/**/*", "outDir": "dist", "watchAssets": true },
            { "include": "gnre/assets/**/*", "outDir": "dist", "watchAssets": true }
        ]
    }
}